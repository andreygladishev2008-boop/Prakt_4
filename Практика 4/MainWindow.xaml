<Window x:Class="Практика_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Практика_4"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*"/>
            <ColumnDefinition Width="1.9*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="10,10,5,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0">
                            <StackPanel>
                                <TextBlock Text="Сотрудник:" FontWeight="Bold" FontSize="18"/>
                                <Label Content="Фамилия:" HorizontalAlignment="Right" Margin="5"/>
                                <Label Content="Имя:" HorizontalAlignment="Right" Margin="5"/>
                                <Label Content="Отчество:" HorizontalAlignment="Right" Margin="5"/>
                                <Label Content="Должность:" HorizontalAlignment="Right" Margin="5"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1">
                            <StackPanel  Height="150">
                                <TextBox VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding LName}" Width="150" x:Name="F" Margin="5,11"/>
                                <TextBox VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding Name}" Width="150" x:Name="I" Margin="5,6"/>
                                <TextBox VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding Otch}" Width="150" x:Name="O" Margin="5,12"/>
                                <TextBox VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding Duty}" Width="150" x:Name="Duty" Margin="5,6"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Новая Запись" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,5" Width="100" x:Name="New" Click="New_Click"/>
                                <Button Content="Сохранить" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,5" Width="75" x:Name="Save" Click="Save_Click_1"/> 
                            </StackPanel> 
                        </Border>
                        <Border Grid.Row="1">
                            <Label Margin="0,10" MinHeight="31" VerticalAlignment="Top">
                                <Label.Content>
                                    <MultiBinding StringFormat="Результат: {0} {1} {2} {3}">
                                        <Binding Path="LName" UpdateSourceTrigger="PropertyChanged"/>
                                        <Binding Path="Name" UpdateSourceTrigger="PropertyChanged"/>
                                        <Binding Path="Otch" UpdateSourceTrigger="PropertyChanged"/>
                                        <Binding Path="Duty" UpdateSourceTrigger="PropertyChanged"/>
                                    </MultiBinding>
                                </Label.Content>
                            </Label>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.7*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Поиск по ID:" VerticalContentAlignment="Center"/>
                                <TextBox TextWrapping="Wrap" VerticalAlignment="Center" Width="180" x:Name="Find_ID"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Column="1">
                            <Button Content="Найти" HorizontalAlignment="Left" VerticalAlignment="Center" Width="50" Height="25" Margin="10" Click="Find_Click" x:Name="Find" />
                        </Border>
                        
                       
                    </Grid>
                </Border>

                <Border Grid.Row="1">
                    <ListView x:Name="ListView_Workers"  ItemsSource="{Binding Workers}" Width="400" Height="290" VerticalAlignment="Center"  HorizontalAlignment="Left" Margin="2">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ID" Width="40"
                            DisplayMemberBinding="{Binding Id}"/>
                                <GridViewColumn Header="ФИО" Width="200"
                            DisplayMemberBinding="{Binding FullName}"/>
                                <GridViewColumn Header="Должность" Width="150"
                            DisplayMemberBinding="{Binding Duty}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
